 function createPerfHooksOutOfRangeError(name, requirement, value) {
   const error = new RangeError(
@@ -73,6 +73,78 @@ function createPerformanceHistogram() {
   };
 }
 
+function createEventLoopDelayHistogram(options = {}) {
+  const resolution = Number(options?.resolution ?? 10);
+  if (!Number.isInteger(resolution) || resolution < 1) {
+    throw createPerfHooksOutOfRangeError("options.resolution", ">= 1", options?.resolution);
+  }
+  const values = [];
+  let timer = null;
+  let expectedAt = 0;
+  const sortedValues = () => values.slice().sort((left, right) => left - right);
+  const percentile = (value) => {
+    const normalized = Number(value);
+    if (!Number.isFinite(normalized) || normalized <= 0 || normalized > 100) {
+      throw createPerfHooksOutOfRangeError("percentile", "> 0 && <= 100", value);
+    }
+    if (values.length === 0) return 0;
+    const sorted = sortedValues();
+    const index = Math.min(
+      sorted.length - 1,
+      Math.max(0, Math.ceil(normalized / 100 * sorted.length) - 1)
+    );
+    return sorted[index];
+  };
+  const monitor = {
+    enable() {
+      if (timer) return false;
+      expectedAt = builtinPerformance.now() + resolution;
+      timer = setInterval(() => {
+        const now = builtinPerformance.now();
+        values.push(Math.max(1, Math.round((now - expectedAt) * 1e6)));
+        if (values.length > 8192) values.shift();
+        expectedAt = now + resolution;
+      }, resolution);
+      timer?.unref?.();
+      return true;
+    },
+    disable() {
+      if (!timer) return false;
+      clearInterval(timer);
+      timer = null;
+      return true;
+    },
+    reset() {
+      values.length = 0;
+    },
+    percentile,
+    get percentiles() {
+      return new Map([50, 75, 90, 99, 100].map((value) => [value, percentile(value)]));
+    },
+    get count() {
+      return values.length;
+    },
+    get exceeds() {
+      return 0;
+    },
+    get min() {
+      return values.length === 0 ? 0 : Math.min(...values);
+    },
+    get max() {
+      return values.length === 0 ? 0 : Math.max(...values);
+    },
+    get mean() {
+      return values.length === 0 ? Number.NaN : values.reduce((sum, value) => sum + value, 0) / values.length;
+    },
+    get stddev() {
+      if (values.length === 0) return Number.NaN;
+      const mean = monitor.mean;
+      return Math.sqrt(values.reduce((sum, value) => sum + (value - mean) ** 2, 0) / values.length);
+    }
+  };
+  return monitor;
+}
