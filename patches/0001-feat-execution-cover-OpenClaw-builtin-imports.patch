   },
@@ -1301,6 +1316,39 @@ var builtinCryptoModule = {
     cryptoPolyfill.getRandomValues(bytes);
     return import_buffer2.Buffer.from(bytes);
   },
+  randomInt(min, max, callback) {
+    let minimum = 0;
+    let maximum = min;
+    let done = max;
+    if (typeof max === "number") {
+      minimum = min;
+      maximum = max;
+      done = callback;
+    }
+    if (!Number.isSafeInteger(minimum) || !Number.isSafeInteger(maximum)) {
+      throw new TypeError('The "min" and "max" arguments must be safe integers');
+    }
+    const range = maximum - minimum;
+    if (range <= 0 || range > MAX_RANDOM_INT_RANGE) {
+      throw new RangeError(
+        `The value of "max - min" is out of range. It must be > 0 and <= ${MAX_RANDOM_INT_RANGE}`
+      );
+    }
+    if (done !== void 0 && typeof done !== "function") {
+      throw new TypeError('The "callback" argument must be of type function');
+    }
+    const randomLimit = RANDOM_INT_ENTROPY_RANGE - RANDOM_INT_ENTROPY_RANGE % range;
+    let randomValue;
+    do {
+      randomValue = builtinCryptoModule.randomBytes(6).readUIntBE(0, 6);
+    } while (randomValue >= randomLimit);
+    const result = minimum + randomValue % range;
+    if (done) {
+      queueMicrotask(() => done(null, result));
+      return;
+    }
+    return result;
+  },
   randomUUID() {
     return cryptoPolyfill.randomUUID();
   },
@@ -1310,4 +1358,4 @@ var builtinCryptoModule = {
