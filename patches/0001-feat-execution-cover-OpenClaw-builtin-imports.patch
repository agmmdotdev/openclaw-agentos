 }
 
+fn javascript_execution_v8_exposes_openclaw_builtin_compatibility_surface() {
+    let temp = tempdir().expect("create temp dir");
+    let mut engine = support::javascript_engine();
+    let context = engine.create_context(CreateJavascriptContextRequest {
+        vm_id: String::from("vm-js"),
+        bootstrap_module: None,
+        compile_cache_root: None,
+    });
+
+    let execution = engine
+        .start_execution(StartJavascriptExecutionRequest {
+            limits: Default::default(),
+            argv0: None,
+            guest_runtime: Default::default(),
+            vm_id: String::from("vm-js"),
+            context_id: context.context_id,
+            argv: vec![String::from("./entry.mjs")],
+            env: BTreeMap::new(),
+            cwd: temp.path().to_path_buf(),
+            wasm_module_bytes: None,
+            inline_code: Some(String::from(
+                r#"
+import readlinePromises from "node:readline/promises";
+import { X509Certificate, hash, randomInt } from "node:crypto";
+import { closeSync, globSync, openSync, readFileSync, writeFileSync, writev } from "node:fs";
+import { flushCompileCache } from "node:module";
+import { monitorEventLoopDelay } from "node:perf_hooks";
+
+if (typeof readlinePromises.createInterface !== "function") throw new Error("readline/promises alias missing");
+if (hash("sha256", "agentos-openclaw", "hex").length !== 64) throw new Error("crypto.hash failed");
+for (let index = 0; index < 32; index += 1) {
+  const value = randomInt(-7, 11);
+  if (!Number.isInteger(value) || value < -7 || value >= 11) throw new Error("crypto.randomInt out of range");
+}
+await new Promise((resolve, reject) => {
+  randomInt(5, (error, value) => error ? reject(error) : value >= 0 && value < 5 ? resolve() : reject(new Error("async crypto.randomInt out of range")));
+});
+
+let x509Error;
+try {
+  new X509Certificate("not-a-certificate");
+} catch (error) {
+  x509Error = error;
+}
+if (x509Error?.code !== "ERR_NOT_IMPLEMENTED") throw new Error("X509Certificate must fail explicitly");
+
+writeFileSync("openclaw-audit.txt", "seed");
+if (!globSync("openclaw-*.txt").includes("openclaw-audit.txt")) throw new Error("fs.globSync failed");
+const fd = openSync("openclaw-writev.txt", "w");
+await new Promise((resolve, reject) => {
+  writev(fd, [Buffer.from("open"), Buffer.from("claw")], 0, (error, bytesWritten) => {
+    if (error) reject(error);
+    else if (bytesWritten !== 8) reject(new Error(`unexpected writev byte count: ${bytesWritten}`));
+    else resolve();
+  });
+});
+closeSync(fd);
+if (readFileSync("openclaw-writev.txt", "utf8") !== "openclaw") throw new Error("fs.writev failed");
+
+if (flushCompileCache() !== undefined) throw new Error("flushCompileCache must return undefined");
+const delay = monitorEventLoopDelay({ resolution: 5 });
+if (typeof delay.enable !== "function" || typeof delay.disable !== "function" || typeof delay.percentile !== "function") {
+  throw new Error("monitorEventLoopDelay surface missing");
+}
+if (!delay.enable()) throw new Error("monitorEventLoopDelay did not enable");
+await new Promise((resolve) => setTimeout(resolve, 15));
+if (delay.count < 1 || delay.percentile(99) < 1 || delay.max < 1) throw new Error("monitorEventLoopDelay did not record");
+if (!delay.disable()) throw new Error("monitorEventLoopDelay did not disable");
+delay.reset();
+if (delay.count !== 0) throw new Error("monitorEventLoopDelay did not reset");
+"#,
+            )),
+        })
+        .expect("start JavaScript execution");
+
+    let result = execution.wait().expect("wait for JavaScript execution");
+    let stdout = String::from_utf8(result.stdout).expect("stdout utf8");
+    let stderr = String::from_utf8(result.stderr).expect("stderr utf8");
+    assert_eq!(
+        result.exit_code, 0,
+        "stdout:\n{stdout}\nstderr:\n{stderr}"
+    );
+    assert!(stderr.is_empty(), "unexpected stderr: {stderr}");
+}
