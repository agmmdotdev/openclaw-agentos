{
  "name": "@agmmdotdev/openclaw-agentos",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw core on published agentOS: artifact adapters and runtime experiments",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.22.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "scripts",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:worker": "pnpm build && node scripts/audit-openclaw-worker.mjs --report docs/compatibility-audit.md",
    "audit:worker:strict": "pnpm build && node scripts/audit-openclaw-worker.mjs --strict",
    "probe:worker": "pnpm build && node scripts/probe-openclaw-worker.mjs",
    "core:build": "tsc -p tsconfig.build.json && node scripts/build-core-artifact.mjs",
    "test:core": "node scripts/probe-core.mjs",
    "test:core:compact": "MALLOC_ARENA_MAX=1 MALLOC_TRIM_THRESHOLD_=65536 MALLOC_MMAP_THRESHOLD_=65536 node scripts/probe-core.mjs",
    "test:core-profile": "node --test test/slice-core-artifact.test.mjs test/schema-collector.test.mjs",
    "test:host-sqlite": "node --test test/host-sqlite.test.mjs",
    "probe:async-context": "node scripts/probe-async-context.mjs",
    "core:report": "node scripts/summarize-core-results.mjs",
    "bench:build": "npm run sdk:build && node scripts/benchmark/build.mjs",
    "bench:wasmer:prewarm": "node scripts/benchmark/prewarm-wasmer.mjs",
    "test:wasmer": "python3 scripts/benchmark/probe-hybrid.py --wasmer --node-memory-profile",
    "test:hybrid:memory": "python3 scripts/benchmark/probe-hybrid.py --node-memory-profile",
    "test:hybrid": "python3 scripts/benchmark/probe-hybrid.py",
    "bench:core": "python3 scripts/benchmark/measure.py",
    "bench:report": "python3 scripts/benchmark/summarize.py",
    "probe:bindings": "node scripts/probe-binding-isolation.mjs",
    "test:core:economy": "node scripts/run-core-economy.mjs scripts/probe-core.mjs",
    "test:core:memory": "CORE_PROBE_REPORT=artifacts/results/core-probe-memory.json node scripts/run-core-memory.mjs scripts/probe-core.mjs",
    "bench:bottlenecks": "python3 scripts/benchmark/bottlenecks.py",
    "test:core-artifacts": "node --test test/core-artifact-store.test.mjs",
    "sdk:build": "npm exec -- tsc -p packages/agentos-sdk/tsconfig.json && node packages/agentos-sdk/scripts/build-native.mjs",
    "test:sdk": "npm run sdk:build && node --test --test-concurrency=1 packages/agentos-sdk/test/*.test.mjs",
    "test:native-sdk": "python3 scripts/benchmark/probe-hybrid.py --native-sdk --node-memory-profile",
    "test:linux-host": "npm run sdk:build && node scripts/linux-host/acceptance.mjs",
    "test:linux-sdk-host": "npm run sdk:build && node scripts/linux-host/sdk-acceptance.mjs",
    "test:request-state": "node --test test/request-state.test.mjs",
    "bench:lifecycle": "python3 scripts/benchmark/request-lifecycle.py",
    "bench:lifecycle:report": "python3 scripts/benchmark/summarize-lifecycle.py",
    "bench:supervisor-control": "node scripts/benchmark/build-supervisor-control.mjs",
    "test:parser-startup": "node --test test/parser-startup.test.mjs",
    "test:native-sdk:request": "python3 scripts/benchmark/probe-hybrid.py --native-sdk --request-profile",
    "profile:startup": "node scripts/diagnostics/profile-native-startup.mjs",
    "test:native-lazy-init": "node --test --test-concurrency=1 test/native-lazy-init.test.mjs test/native-highlight-module.test.mjs",
    "bench:parser": "node scripts/benchmark/parser-throughput.mjs",
    "test:request-launcher": "node --test test/request-launcher.test.mjs",
    "source-core:install": "npm ci --prefix packages/openclaw-core --ignore-scripts --no-audit --no-fund",
    "source-core:build": "node packages/openclaw-core/build.mjs && CORE_DIAGNOSTICS=1 node packages/openclaw-core/build.mjs && node scripts/benchmark/build-source-core.mjs",
    "test:source-core": "node --test --test-concurrency=1 test/source-core.test.mjs"
  },
  "dependencies": {
    "@rivet-dev/agentos-core": "0.2.19",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1 <2027"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@wasmer/sdk": "0.11.0",
    "esbuild": "0.28.2",
    "openclaw": "2026.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
